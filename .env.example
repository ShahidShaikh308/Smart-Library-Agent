# Provider: openrouter, openai, gemini, groq, or ollama
LLM_PROVIDER=openrouter
LLM_MODEL=cohere/north-mini-code:free

# Optional comma-separated fallback model names. OpenRouter uses its own list.
# Example: cohere/north-mini-code:free,mistralai/mistral-small-3.2:free
OPENROUTER_FALLBACK_MODELS=
LLM_FALLBACK_MODELS=

# Set the key required by LLM_PROVIDER. Keep secrets out of source control.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional provider settings
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=60
LLM_RETRIES=2
LLM_RETRY_BASE_SECONDS=1
LLM_RETRY_MAX_SECONDS=8

# Agent safety and diagnostics
AGENT_MAX_TOOL_ROUNDS=4
AGENT_DEBUG=false
